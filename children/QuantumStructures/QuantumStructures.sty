%% QuantumStructures.sty — project style file for QuantumStructures.tex
%%
%% This is the SOLE package loaded by QuantumStructures.tex. It (1) loads the
%% shared preamble packages vendored in _packages/ (pristine copies pinned in
%% _packages/vendor.lock — DO NOT edit them there), then (2) defines everything
%% specific to this paper in the "Project-specific additions" section.
%%
%%   Shared, vendored (edit upstream in LaTeX-shared-files, then re-sync):
%%     di-base-core     — engine-aware fonts, packages, hyperref/cleveref,
%%                         theorem family (loaded transitively by di-base-article)
%%     di-base-article  — core + section-scoped numbering (amsart)
%%     di-structures    — real-valued-logic notation (bb/frak/script/operators/…)
%%   Project-specific (EDIT HERE — see STYLE.md):
%%     geometry, mathbbol, local theorem envs, Greek overrides, project macros.
%%
%% This paper is pdfLaTeX-only (enshrined below); the vendored core is
%% engine-aware but QS deliberately refuses Xe/LuaLaTeX.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{QuantumStructures}[2026/07/15 QuantumStructures project preamble]

% Enshrine pdfLaTeX: refuse XeLaTeX/LuaLaTeX rather than silently taking the
% Unicode-math branch of the vendored core (which would change font metrics).
\RequirePackage{iftex}
\RequirePDFTeX

% ═══════════════════════════════════════════════════════════════════════════
%% Vendored shared packages  (pristine copies in _packages/; DO NOT edit there)
% ═══════════════════════════════════════════════════════════════════════════
% di-base-article \RequirePackage{di-base-core} internally, so di-base-core.sty
% must be vendored alongside it (it is; pinned in _packages/vendor.lock).

%%% Vendored: eduenez/LaTeX-shared-files/di-base-article.sty @ af98e4f
%%%           (pulls in di-base-core.sty @ af98e4f)
\usepackage{di-base-article}

%%% Vendored: eduenez/LaTeX-shared-files/di-structures.sty @ af98e4f
\usepackage{di-structures}

