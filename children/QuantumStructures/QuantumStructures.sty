% ═══════════════════════════════════════════════════════════════════════════
%% Project-specific additions  (EDIT MACROS HERE — see STYLE.md)
% ═══════════════════════════════════════════════════════════════════════════

% ─── Page Layout ─────────────────────────────────────────────────────────────
\RequirePackage[margin=1.15in]{geometry}

% ─── Additional packages ─────────────────────────────────────────────────────
\RequirePackage{mathbbol}

% ─── Greek-letter overrides (project preference; not in the shared core) ─────
\renewcommand{\phi}{\varphi}
\renewcommand{\epsilon}{\varepsilon}

% ─── Local theorem environments (not in the shared core) ─────────────────────
% \claim is intentionally local: papers disagree on numbering, so the shared
% core omits it.  QuantumStructures uses an UNnumbered claim.
\theoremstyle{plain}
\newtheorem*{claim}{Claim}

% ─── Operators not in di-structures ──────────────────────────────────────────
\DeclareMathOperator{\Av}{Av}
\DeclareMathOperator{\sub}{sub}

% ─── Logic/relation symbols not in di-structures ─────────────────────────────
\newcommand{\aore}{\forall \vee \exists}
\newcommand{\wneg}{\mathrel{\ooalign{\hss$\neg$\hss\cr\kern0.2ex\raise1.0ex\hbox{\scalebox{0.7}{w}}}}}
\def\Aapp{\mathrel\cA\joinrel\approx}
\renewcommand{\appto}{\mathrel{\ooalign{\hss$\Leftarrow$\hss\cr\kern0.9ex\raise0.25ex\hbox{\scalebox{0.6}{$\sim$}}}}}
\newcommand{\appby}{\mathrel{\ooalign{\hss$\Rightarrow$\hss\cr\kern0.3ex\raise0.25ex\hbox{\scalebox{0.6}{$\sim$}}}}}

% ─── Bold capital aliases ─────────────────────────────────────────────────────
\newcommand{\BH}{\mathbf{H}}
\newcommand{\BL}{\mathbf{L}}
\newcommand{\BP}{\mathbf{P}}
\newcommand{\bU}{\mathbb{U}}

% ─── Fraktur hat-decorated forms ─────────────────────────────────────────────
\newcommand{\hfM}{\Hat{\fM}}
\newcommand{\hfN}{\Hat{\fN}}

% ─── Specialized macros ───────────────────────────────────────────────────────
\renewcommand{\dd}{\ensuremath{\mathrm{d}}}
\newcommand{\Los}{{\L}o\'s}
\newcommand{\omp}{\ensuremath{\omega^+}}
\newcommand{\lixd}{\ensuremath{\ell^\infty(X_\lambda,d_\lambda)_{\Lambda}}}
