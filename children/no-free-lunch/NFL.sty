%% NFL.sty — project style file for NFL.tex (No Free Lunch paper, amsart)
%%
%% This is the SOLE package loaded by NFL.tex. It (1) loads the shared preamble
%% packages vendored in _packages/ (pristine copies pinned in _packages/vendor.lock
%% — DO NOT edit them there), then (2) defines everything specific to this paper
%% in the "Project-specific additions" section.
%%
%%   Shared, vendored (edit upstream in LaTeX-shared-files, then re-sync):
%%     di-base-article — amsart section-scoped numbering; pulls in di-base-core
%%                        (engine-aware fonts, packages, hyperref/cleveref,
%%                        theorem family, todonotes)
%%   Project-specific (EDIT HERE):
%%     geometry, graphics, NFL macros and extra theorem envs.
%%
%% History: this replaces the former `di-base` submodule and the once-inlined,
%% pin-@73514b4 Section 1; the shared preamble is now vendored per-file in
%% _packages/ (see CRITICAL-README-Breaking-Changes-2026-07-15.md).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{NFL}[2026/07/15 No Free Lunch project preamble]

