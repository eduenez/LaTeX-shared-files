% must be vendored alongside it (it is; pinned in _packages/vendor.lock).

%%% Vendored: eduenez/LaTeX-shared-files/di-base-monograph.sty @ af98e4f
%%%           (pulls in di-base-core.sty @ af98e4f)
\usepackage{di-base-monograph}

