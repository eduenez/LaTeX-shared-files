% ═══════════════════════════════════════════════════════════════════════════
%% Project-specific additions  (EDIT HERE)
% ═══════════════════════════════════════════════════════════════════════════

% ── Page layout (memoir owns its geometry; set here, not in the .tex) ────────
\setlrmarginsandblock{3.5cm}{2.5cm}{*}
\setulmarginsandblock{3cm}{3cm}{*}
\checkandfixthelayout
\chapterstyle{madsen}
\nouppercaseheads
\pagestyle{ruled}

% ── Graphics, tables (not provided by the shared core) ───────────────────────
% (di-base-core already loads tikz-cd, hence tikz; these add the rest.)
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{booktabs}
\RequirePackage{subcaption}

% ── Extra theorem-like environments (independent counters, reset per chapter) ─
% \claim and \keyfact(s) use their own counters, not the shared `theorem' one.
\theoremstyle{plain}
\newtheorem{claim}{Claim}[chapter]
\newtheorem{keyfact}{Key Fact}[chapter]
\newtheorem{keyfacts}{Key Facts}[chapter]

% ── Number sets ──────────────────────────────────────────────────────────────
\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}

% ── Category- and topos-theoretic notation ───────────────────────────────────
\newcommand{\Set}{\mathbf{Set}}        % category of sets
\newcommand{\Cat}{\mathbf{Cat}}        % category of (small) categories
\newcommand{\Topos}{\mathcal{E}}       % a generic (elementary) topos
\newcommand{\Omg}{\Omega}              % subobject classifier
\newcommand{\Sh}[1]{\mathrm{Sh}(#1)}   % category of sheaves on a site
\newcommand{\Sub}[1]{\mathrm{Sub}(#1)} % subobject lattice/poset
\newcommand{\Heyt}{\mathcal{H}}        % a generic Heyting algebra
\newcommand{\geoto}{\rightleftarrows}  % geometric morphism (f^* \dashv f_*)
\newcommand{\adj}[2]{#1 \dashv #2}     % adjunction notation

% ── Operators and delimiters ─────────────────────────────────────────────────
\DeclareMathOperator{\id}{id}
\DeclareMathOperator{\Hom}{Hom}
\DeclareMathOperator{\colim}{colim}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\pair}{\langle}{\rangle}
\DeclarePairedDelimiter{\set}{\{}{\}}
