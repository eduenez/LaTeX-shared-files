%% topos-logic.sty — project style file for topos-logic.tex (memoir monograph)
%%
%% This is the SOLE package loaded by topos-logic.tex. It (1) loads the shared
%% preamble packages vendored in _packages/ (pristine copies pinned in
%% _packages/vendor.lock — DO NOT edit them there), then (2) defines everything
%% specific to this monograph in the "Project-specific additions" section
%% (including the memoir page layout, since only \documentclass and semantic
%% metadata belong in the .tex).
%%
%%   Shared, vendored (edit upstream in LaTeX-shared-files, then re-sync):
%%     di-base-core       — engine-aware fonts, packages, hyperref/cleveref,
%%                           theorem family (loaded transitively by di-base-monograph)
%%     di-base-monograph  — core + chapter-scoped numbering + axiom (memoir)
%%   Project-specific (EDIT HERE):
%%     memoir layout, graphics packages, topos notation, extra theorem envs.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{topos-logic}[2026/07/15 topos-logic monograph preamble]

% ═══════════════════════════════════════════════════════════════════════════
