%% di-random.sty — Dueñez–Iovino notation for randomized structures
%%
%% Notation specific to Keisler randomizations, probability algebras,
%% and stochastic structures.  Extends di-structures.sty.
%%
%% Requires di-base and di-structures to be loaded first.
%%
%% Note: the svrsymbols package (provides \dicevi used for \rnd) is loaded
%% here.  It must come after stix to avoid symbol-slot conflicts.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{di-random}[2026/05/31 Duenez-Iovino randomized structures notation]

\RequirePackage{svrsymbols}  % \dicevi for randomization symbol

% ── Randomization symbol ─────────────────────────────────────────────────────

\newcommand{\rnd}{\text{\small\dicevi}}   % randomization functor symbol
\newcommand{\frnd}{\mathfrak{r}}          % fraktur randomization
\newcommand{\fMrnd}{\mathfrak{M}^{\rnd}}
\newcommand{\fNrnd}{\mathfrak{N}^{\rnd}}

% ── Probability and measure ───────────────────────────────────────────────────

\newcommand{\Pb}{\mathbb{P}}              % probability measure
\newcommand{\PR}{\mathbb{P}_{\RR}}
\newcommand{\Pw}{P_w}                     % weak probability
\newcommand{\Rw}{R_w}                     % weak randomization

% ── Bold capital families (random variables, matrices) ───────────────────────

\newcommand{\Ba}{\mathbf{a}}
\newcommand{\Bb}{\mathbf{b}}
\newcommand{\Bc}{\mathbf{c}}
\newcommand{\Bd}{\mathbf{d}}
\newcommand{\Be}{\mathbf{e}}
\newcommand{\Bx}{\mathbf{x}}
\newcommand{\By}{\mathbf{y}}
\newcommand{\Bz}{\mathbf{z}}
\newcommand{\Bbx}{\bar{\mathbf{x}}}
\newcommand{\Bby}{\bar{\mathbf{y}}}
\newcommand{\Bbz}{\bar{\mathbf{z}}}
\newcommand{\Bone}{\mathbf{1}}
\newcommand{\Bzero}{\mathbf{0}}

% ── Stone space and compact structure notation ────────────────────────────────

\newcommand{\Cb}{C(\mathfrak{b})}
\newcommand{\Cp}{C(\mathfrak{p})}

% ── Extended L^p notation for probability spaces ─────────────────────────────

\newcommand{\Lonep}{L^{1}(\mathbb{P})}
\newcommand{\Linfp}{L^{\infty}(\mathbb{P})}
\newcommand{\Linfty}{L^{\infty}}          % alias; also see \Linf in di-structures
\newcommand{\Lfi}{L^{<\infty}}            % finitely-supported
\newcommand{\Lfin}{L^{\mathrm{fin}}}
\newcommand{\Lfinp}{L^{\mathrm{fin}}(\mathbb{P})}
\newcommand{\Lsec}{L^{\mathrm{sec}}}     % section L^p

% ── Vector probability spaces ─────────────────────────────────────────────────

\newcommand{\VLfi}{V_{L^{<\infty}}}
\newcommand{\VLoi}{V_{L^{1}}}
\newcommand{\VHs}{V_{H}}
\newcommand{\Vprob}{V_{\mathrm{prob}}}
\newcommand{\Vunrm}{V_{\mathrm{unrm}}}
\newcommand{\Vddvec}{V_{\mathrm{ddvec}}}
\newcommand{\Valg}{V_{\mathrm{alg}}}
\newcommand{\Vinf}{V_{\infty}}

% ── Pairing extensions for randomized spaces ─────────────────────────────────

\newcommand{\Npair}[2]{\ensuremath{\left\lVert #1, #2 \right\rVert}}
\newcommand{\Nrmw}[1]{\ensuremath{\left\lVert #1 \right\rVert_w}}
\newcommand{\pairX}[2]{\ensuremath{\left\langle #1, #2 \right\rangle_X}}
\newcommand{\pairY}[2]{\ensuremath{\left\langle #1, #2 \right\rangle_Y}}
\newcommand{\pairdot}[2]{\ensuremath{\left\langle #1, #2 \right\rangle_{\cdot}}}

% ── Structural type families for randomized structures ────────────────────────

\newcommand{\Btp}{B_{\tp}}
\newcommand{\Cbtp}{C(\mathfrak{b})_{\tp}}
\newcommand{\Ccl}{\overline{C}}          % topological closure of C
\newcommand{\Cl}{\mathrm{Cl}}            % closure operator
\newcommand{\Ctp}{C_{\tp}}
\newcommand{\dtp}{d_{\tp}}
\newcommand{\Ntp}{N_{\tp}}
\newcommand{\Ptp}{P_{\tp}}
\newcommand{\PtpX}{P_{\tp,X}}
\newcommand{\PtpY}{P_{\tp,Y}}
\newcommand{\QF}{Q_{\cF}}
\newcommand{\QFZ}{Q_{\cF,\ZZ}}
\newcommand{\ST}{S^{\top}}

% Additional operator for randomized structures
\DeclareMathOperator{\Std}{std}          % standard part
\DeclareMathOperator{\Sg}{Sg}            % subgroup generated by

% ── Supplementary operators ───────────────────────────────────────────────────

\newcommand{\weakst}{\overset{w^*}{\to}}  % weak-* convergence
\newcommand{\ketX}[1]{\left| #1 \right\rangle_X}
\newcommand{\ketOm}[1]{\left| #1 \right\rangle_\Omega}
\newcommand{\lvec}[1]{\vec{#1}}
\newcommand{\rsup}{\mathrm{sup}}
\newcommand{\fin}{\mathrm{fin}}
\newcommand{\LC}{L_C}
\newcommand{\LVC}{L_{VC}}
\newcommand{\VC}{V_C}
\newcommand{\VDLP}{V_{\mathrm{DLP}}}
\newcommand{\VDP}{V_{\mathrm{DP}}}
