%% di-ramsey.sty — Dueñez–Iovino notation for Ramsey theory and combinatorics
%%
%% Notation specific to ultrafilter semigroups, idempotent types, continuous
%% Ramsey theory, Hindman's theorem, and stable Boolean algebras.
%% Extends di-structures.sty.
%%
%% Requires di-base and di-structures to be loaded first.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{di-ramsey}[2026/05/31 Duenez-Iovino Ramsey and combinatorics notation]

% ── Semigroup and ultrafilter operations ─────────────────────────────────────

% Ultrafilter limits (lower-case: idempotent/semigroup context)
\DeclareMathOperator*{\ulim}{u\text{-}\!\lim}
\DeclareMathOperator*{\Ilim}{I\text{-}\!\lim}

% Tensor/semigroup product of types
\newcommand{\Pggd}{\mathrel{\succcurlyeq^{\!\!d}}}
\newcommand{\Pgm}{\mathrel{\succcurlyeq_m}}
\newcommand{\Plld}{\mathrel{\preccurlyeq^{\!\!d}}}
\newcommand{\Plmm}{\mathrel{\preccurlyeq_m}}
\newcommand{\Pll}{\mathrel{\preccurlyeq}}
\newcommand{\Pgg}{\mathrel{\succcurlyeq}}
\newcommand{\Pm}{\mathrel{\succsim}}
\newcommand{\Pmf}{\mathrel{\succsim_f}}

