%% di-bipartite-figures.sty — tikz helpers shared by the figure bodies of the
%% "Classification of bipartite observables" series (Quantum_NIP, the survey):
%% venn_body.tex, hepta_body.tex, tree_body.tex.
%% Requires the series palette (deepblue, midblue, urlpurple, palepurple); it is
%% supplied here only if the document has not defined it already.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{di-bipartite-figures}[2026/10/13 Duenez-Iovino tikz helpers for the bipartite-observables figures]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta}

% Palette of the research papers (blue and purple); \providecolor keeps the document's own.
\providecolor{deepblue}{RGB}{30,78,140}       % frames, rules, headings
\providecolor{midblue}{RGB}{52,120,190}       % citations
\providecolor{urlpurple}{RGB}{120,81,169}     % urls
\providecolor{palepurple}{RGB}{236,230,246}   % fills

% Venn diagram (venn_body.tex): ellipse centred on the x-axis from x=#1 to x=#2, vertical semi-axis #3.
\newcommand{\VennRing}[3]{({(#1+#2)/2},0) ellipse ({(#2-#1)/2} and #3)}

% Heptachotomy figure (hepta_body.tex); uses the colours `vtext' and `bump' set by the figure.
% Column background at x=#1 with header #2, fill #3 and label #4.
\newcommand{\HeptaCol}[4]{%
  \fill[#3, rounded corners=4pt] (#1,0.85) rectangle ++(3.65,-9.05);
  \node[vtext, font=\footnotesize\bfseries, align=center, anchor=south] at ({#1+1.825},-0.08) {#2};
  \node[vtext, font=\scriptsize\itshape] at ({#1+1.825},-0.24) {#4};}
% Panel frame at (#1,#2) with title #3, subtitle #4 and caption #5.
\newcommand{\HeptaPanel}[5]{%
  \draw[white, line width=1pt, rounded corners=3pt] (#1+0.1,#2-0.05) rectangle ++(3.45,-3.65);
  \node[vtext, font=\footnotesize\bfseries] at ({#1+1.825},#2-2.1) {#3};
  \node[vtext, text width=3.3cm, align=center, anchor=north] at ({#1+1.825},#2-2.28) {\textit{#4}\\[1pt] #5};}
% Bump (uniform density) of width #2 at x=#1, height #3, baseline y=#4.
\newcommand{\HeptaBump}[4]{\fill[bump!55] (#1,#4) rectangle ++(#2,#3); \draw[bump, line width=0.4pt] (#1,#4) rectangle ++(#2,#3);}
