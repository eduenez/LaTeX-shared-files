%% di-quantum.sty — notation shared by the quantum-information papers
%% (Qbipartite_* series, survey; reusable by any paper on operator algebras / quantum logic).
%%
%% PROPOSED new shared package. Loads only math packages; does NOT change fonts
%% or theorem styles. Pair with di-alphabets for \NN \RR \cH \fD ...
%%
%% Conflict resolutions (see macro-map):
%%   \Tr   = trace (operator). The "tree" macro of the logic books is \tr.
%%   \one  = \mathbf{1}.
%%   \ind  = lives in di-logic.sty now (one independence symbol for all papers).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{di-quantum}[2026/10/19 Duenez-Iovino quantum notation]
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}  % \DeclarePairedDelimiter

\DeclareMathOperator{\Tr}{Tr}      % trace
\DeclareMathOperator{\spn}{span}   % linear span
\newcommand{\one}{\mathbf{1}}      % identity / constant-one element
\newcommand{\ee}{\mathrm{e}}       % Euler's number
\newcommand{\oA}{\otimes_{\mathsf{A}}}   % tensor over party A
\newcommand{\oB}{\otimes_{\mathsf{B}}}   % tensor over party B

% Hilbert space: calligraphic H (requires di-alphabets for \cH).
\providecommand{\cH}{\mathcal{H}}
\newcommand{\Hil}{\cH}

% Dirac notation: \ket{u} = |u>, \bra{u} = <u|; the starred forms (\ket*{...}) size the delimiters
% automatically, and an optional size argument (\ket[\big]{...}) fixes them.
\DeclarePairedDelimiter{\ket}{\lvert}{\rangle}
\DeclarePairedDelimiter{\bra}{\langle}{\rvert}
