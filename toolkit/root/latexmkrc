# latexmkrc — shared latexmk configuration for ALL papers in this repository.
#
# Each paper lives in its own subdirectory (e.g. my-paper/my-paper.tex). Build
# a paper by running latexmk from inside its directory (a one-line latexmkrc
# there loads this file), or from the repo root with `make my-paper`.
# VS Code (LaTeX Workshop) passes this file explicitly via `latexmk -r`.
#
# Engine: pdfLaTeX (uniform across the group; STIX Two fonts).
#
# Output layout (relative to the paper's directory): the PDF lands next to the
# source; intermediates (.aux, .log, .bbl, …) go to _build/. Both are gitignored.
#
# NOTE: this governs latexmk only. A manual `pdflatex; bibtex; pdflatex` run
# ignores this file; it still works (each paper's .tex finds the shared files
# via ../_packages/ and ../references.bib) but leaves intermediates beside the
# source.

use File::Basename qw(dirname);
use Cwd qw(abs_path);

# Absolute path of the repo root (the directory containing THIS file), so the
# configuration is independent of which paper directory latexmk runs in.
# (a repository that uses LaTeX-shared-files as a submodule has a stub latexmkrc that sets $_repo_root, then loads this file)
$_repo_root = abs_path(dirname(__FILE__)) unless defined $_repo_root;

# Vendored shared packages (di-base-*, …) and the shared bibliography.
ensure_path('TEXINPUTS', "$_repo_root/_packages//");
ensure_path('BIBINPUTS', $_repo_root);
ensure_path('BSTINPUTS', "$_repo_root/_packages//");   # di-amsalpha.bst

$aux_dir = '_build';
$out_dir = '.';

$pdf_mode = 1;   # pdflatex → PDF
$pdflatex = 'pdflatex -interaction=nonstopmode -synctex=1 %O %S';

# Monographs \include chapter files; $emulate_aux lets latexmk manage their
# per-file .aux inside $aux_dir without "cannot find .aux" complaints.
$emulate_aux = 1;

# Run bibtex from the paper's directory (not from inside _build/), so that
# \bibliography{../references} resolves exactly as in a manual run.
$bibtex_fudge = 0;

# Default documents. A paper's own latexmkrc normally names its main file(s) with @default_files BEFORE loading
# this file. If it does not (or there is none), build every master of the current directory: each .tex that has an
# uncommented \documentclass (standalone figure documents excepted). So a directory with several masters, or one
# whose master was added later, needs no configuration; \include'd children are never built directly.
# latexmk's own default is ('*.tex'), not empty, so that value also counts as "not named". A master without a
# \documentclass of its own (a wrapper that \inputs another) is not found; name it in @default_files. If no master is
# found, latexmk's default stays.
if (!@default_files || "@default_files" eq '*.tex') {
  @default_files = ();
  if (opendir(my $dh, '.')) {
    foreach my $f (sort grep { /\.tex$/ } readdir($dh)) {
      open(my $fh, '<', $f) or next;
      my $master = 0;
      while (my $l = <$fh>) {
        next if $l =~ /^\s*%/;
        if ($l =~ /^[^%]*\\documentclass/) { $master = ($l !~ /\{standalone\}/); last; }
      }
      close($fh);
      push @default_files, $f if $master;
    }
    closedir($dh);
  }
  @default_files = ('*.tex') unless @default_files;
}

# Unwrapped log lines: TeX wraps its log at 79 columns by default, which breaks
# the file and line attribution of errors and warnings in editors (AUCTeX),
# agents and CI. The variable reaches the engine through the environment.
$ENV{'max_print_line'} = 10000;

# The house commit checks (an advisory git pre-commit hook: reminders only, never blocks a commit) are installed once per
# clone by the first build, so nobody has to remember `make install-hooks`. Fast path: the hook is there and is ours.
# Opt out per clone with `git config house.hooks off`. Not attempted on native Windows (no bash; use the dev container).
unless ($^O eq 'MSWin32') {
  my $hook = -d "$_repo_root/.git" ? "$_repo_root/.git/hooks/pre-commit" : '';
  my $ours = 0;
  if ($hook && open(my $h, '<', $hook)) { local $/; $ours = (<$h> =~ /house-hook v1/); close($h); }
  unless ($ours) {
    foreach my $s ("$_repo_root/_scripts/setup-hooks.sh", "$_repo_root/_packages/toolkit/scripts/setup-hooks.sh") {
      if (-f $s) { system("cd '$_repo_root' && bash '$s' --ensure 2>/dev/null"); last; }
    }
  }
}
