% ── Norm and pairing delimiters ───────────────────────────────────────────────
%
% These use \left/\right for automatic sizing.  For a fixed-size version,
% use \bigl|\cdot\bigr| directly.  mathtools' \DeclarePairedDelimiter is
% preferred for new code (\nrm*{x} auto-sizes, \nrm{x} is fixed-small)
% but kept simple here for backward compatibility.

\newcommand{\nrm}[1]{\ensuremath{\left\lvert #1 \right\rvert}}
\newcommand{\Nrm}[1]{\ensuremath{\left\lVert #1 \right\rVert}}
\newcommand{\NRM}[1]{\ensuremath{\left\lVert #1 \right\rVert_{\infty}}}
\newcommand{\Ninf}[1]{\ensuremath{\left\lVert #1 \right\rVert_{\infty}}}
\newcommand{\None}[1]{\ensuremath{\left\lVert #1 \right\rVert_{1}}}
\newcommand{\pair}[2]{\ensuremath{\left\langle #1, #2 \right\rangle}}
\newcommand{\Pair}[2]{\ensuremath{\left\langle #1 \,\middle|\, #2 \right\rangle}}

% Delimiter families built from stix bracket primitives
\newcommand{\Angle}[1]{\ensuremath{\left\langle #1 \right\rangle}}
\newcommand{\Brack}[1]{\ensuremath{\left\lbrack #1 \right\rbrack}}
\newcommand{\Brace}[1]{\ensuremath{\left\lbrace #1 \right\rbrace}}
\newcommand{\Paren}[1]{\ensuremath{\left( #1 \right)}}
\newcommand{\lrAngle}[1]{\ensuremath{\left\langle\!\left\langle
  #1 \right\rangle\!\right\rangle}}

