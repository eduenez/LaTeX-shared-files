\newcommand{\isforcedby}{\Vdash^{-1}}
\newcommand{\ismodeledby}{\vDash}
\newcommand{\nmodels}{\nvDash}
\newcommand{\wforces}{\Vdash_w}
\newcommand{\nwforces}{\nVdash_w}
\newcommand{\appmod}{\approx_{\mathrm{mod}}}
\newcommand{\nappmod}{\not\approx_{\mathrm{mod}}}

